{
  "name": "@japa/snapshot",
  "description": "Snapshot testing plugin for Japa",
  "version": "2.0.10",
  "engines": {
    "node": ">=18.16.0"
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "clean": "del-cli build",
    "precompile": "npm run lint && npm run clean",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "release": "release-it",
    "version": "npm run build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "lint": "eslint",
    "format": "prettier --write .",
    "quick:test": "node --import=@poppinss/ts-exec bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^3.0.0-next.5",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0-next.3",
    "@japa/assert": "^4.2.0",
    "@japa/expect": "^3.0.7",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.0.0",
    "@poppinss/ts-exec": "^1.4.1",
    "@release-it/conventional-changelog": "^10.0.3",
    "@types/dedent": "^0.7.2",
    "@types/node": "^25.0.1",
    "@types/stack-utils": "^2.0.3",
    "c8": "^10.1.3",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.2",
    "expect": "^30.2.0",
    "prettier": "^3.7.4",
    "release-it": "^19.1.0",
    "tsdown": "^0.17.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dedent": "^1.7.0",
    "jest-message-util": "^30.2.0",
    "magic-string": "^0.30.21",
    "pretty-format": "^30.2.0",
    "stack-utils": "^2.0.6"
  },
  "peerDependencies": {
    "@japa/assert": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "@japa/expect": "^3.0.2",
    "@japa/runner": "^3.1.2 || ^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@japa/assert": {
      "optional": true
    },
    "@japa/expect": {
      "optional": true
    }
  },
  "homepage": "https://github.com/japa/snapshot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japa/snapshot.git"
  },
  "bugs": {
    "url": "https://github.com/japa/snapshot/issues"
  },
  "keywords": [
    "japa",
    "snapshot",
    "snapshot-testing"
  ],
  "author": "japa, Julien Ripouteau <julien@ripouteau.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./src/types.ts"
    ],
    "external": [
      "expect"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
